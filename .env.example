# Copy to .env for local configuration. Real deployments must set a high-entropy JWT_SECRET.
LEARNMATE_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_PATH=./data/learnmate.db
JWT_SECRET=local-development-only-change-me
JWT_ACCESS_EXPIRY_MINUTES=20
JWT_REFRESH_EXPIRY_DAYS=14
REQUEST_RATE_PER_MINUTE=120

# Tutor and reviewer share this provider adapter; responses remain unverified until a reviewer is configured.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
REVIEWER_MODEL=

# Planned integration adapters are documented in docs/architecture.md.
# DATABASE_CONNECTION_STRING=
# CACHE_URL=
# VECTOR_DATABASE_URL=
# OBJECT_STORAGE_BUCKET=
# MESSAGE_BROKER_URL=
# GOOGLE_MEET_CREDENTIALS=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# SMTP_HOST=
# PAYMENT_GATEWAY=
